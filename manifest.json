{
  "manifest_version": 3,
  "name": "Oracle Docs Readability Enhancer",
  "version": "1.0",
  "description": "Injects into Oracle Java docs to improve readability.",
  "icons": {
    "16": "icons/oracle-formatted-16.png",
    "32": "icons/oracle-formatted-32.png",
    "48": "icons/oracle-formatted-48.png",
    "128": "icons/oracle-formatted-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.oracle.com/*"
      ],
      "css": [
        "oracleStyles.css"
      ],
      "run_at": "document_start"
    }
  ]
}